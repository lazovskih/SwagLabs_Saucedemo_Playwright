{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@utilities/*": ["./tests/utilities/*"],
      "@pages/*": ["./tests/pages/*"],
      "@data-types": ["./tests/types/index"],
      "@data/*": ["./data/*"],
      "@fixtures/*": ["./tests/fixtures/*"]
    }
  },
  "include": ["**/*.ts", "**/*.json", "tests/**/*", "playwright.config.ts"]
}
