{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["DOM", "ES2020"],
    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@helpers/*": ["tests/utilities/*"],
      "@fixtures/*": ["tests/fixtures/*"],
      "@pages/*": ["tests/pages/*"]
    }
  },
  "include": ["**/*.ts"]
}
