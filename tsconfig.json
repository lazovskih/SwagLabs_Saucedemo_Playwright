{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@helpers/*": ["tests/utilities/*"],
      "@pages/*": ["tests/pages/*"],
      "@data-types": ["tests/types/index"]
    }
  },
  "include": ["**/*.ts", "**/*.json"]
}
